#!/bin/sh
# Neptune Video portable launcher: runs bin/neptune-video from the bundle this file lives in.
set -u

self=$0
case $self in
    */*) ;;
    *) self=./$self ;;
esac

# Follow symlinks to the launcher so the bundle is found from a link elsewhere.
hops=0
while [ -L "$self" ]; do
    hops=$((hops + 1))
    if [ "$hops" -gt 32 ]; then
        printf '%s\n' "AppRun: too many symbolic links: $0" >&2
        exit 1
    fi
    link_dir=$(CDPATH='' cd -- "$(dirname -- "$self")" && pwd -P) || exit 1
    target=$(readlink -- "$self") || exit 1
    case $target in
        /*) self=$target ;;
        *) self=$link_dir/$target ;;
    esac
done

bundle=$(CDPATH='' cd -- "$(dirname -- "$self")" && pwd -P) || exit 1
neptune_video=$bundle/bin/neptune-video

if [ ! -f "$neptune_video" ]; then
    printf '%s\n' "AppRun: missing $neptune_video" >&2
    exit 127
fi
if [ ! -x "$neptune_video" ]; then
    printf '%s\n' "AppRun: not executable: $neptune_video" >&2
    exit 126
fi

# The working directory, PATH, NEPTUNE_VIDEO_FFMPEG and NEPTUNE_VIDEO_FFPROBE pass through
# unchanged; Neptune Video finds the ffmpeg and ffprobe in bin/ beside it itself.
exec "$neptune_video" "$@"
